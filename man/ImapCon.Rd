Default is \code{1}.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    A \code{data.frame} with one row per MIME part of each message.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
