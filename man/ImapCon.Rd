\subsection{\code{ImapCon$select_folder()}}{
  Select a mail folder.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{ImapCon$select_folder(name, mute = FALSE, retries = 1, condstore = FALSE)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
