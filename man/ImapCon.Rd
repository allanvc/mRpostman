  body. Requires the server \code{PREVIEW} capability.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{ImapCon$fetch_preview(msg_id, use_uid = FALSE, retries = 1)}
    \if{html}{\out{</div>}}
