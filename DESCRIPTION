Package: mRpostman
Type: Package
Title: An IMAP4rev2 Client for R
Version: 2.3.0
Date: 2026-08-28
Authors@R: c(
    person(given="Allan", family="Quadros",
    role = c("aut", "cre"),
    email = "allanvcq@gmail.com",
    comment = c(ORCID = "0000-0003-3250-5380")),
